{
  "expo": {
    "name": "PlusPuls",
    "slug": "pluspuls",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pluspuls",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "android": {
      "package": "pl.pluspuls.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0D14"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PlusPuls uses your location to center the Kraków demand map. Your position stays on this device."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0D14",
          "image": "./assets/splash.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "abd56f8d-871a-48b0-9364-ffe9a7dffb26"
      }
    },
    "owner": "mwg25"
  }
}