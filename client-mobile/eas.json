{
  "cli": {
    "version": ">= 21.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "node": "22.13.1",
      "developmentClient": false,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pluspulszip-1.onrender.com",
        "EXPO_PUBLIC_RELEASE_CHANNEL": "preview",
        "EXPO_PUBLIC_ALLOW_EXTERNAL_SUBSCRIPTIONS": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "22.13.1",
      "developmentClient": false,
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pluspulszip-1.onrender.com",
        "EXPO_PUBLIC_RELEASE_CHANNEL": "production",
        "EXPO_PUBLIC_ALLOW_EXTERNAL_SUBSCRIPTIONS": "false"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
