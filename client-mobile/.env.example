# Public values only. Never place credentials in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=https://pluspulszip-1.onrender.com
GOOGLE_MAPS_ANDROID_API_KEY=replace-with-an-android-restricted-key
EXPO_PUBLIC_ANDROID_APK_URL=
EXPO_PUBLIC_ANDROID_APK_SHA256=
EXPO_PUBLIC_RELEASE_VERSION=1.2.3
EXPO_PUBLIC_RELEASE_CHANNEL=development
# true only for private/internal APKs. Keep false for every Google Play build.
EXPO_PUBLIC_ALLOW_EXTERNAL_SUBSCRIPTIONS=false
