# Local development
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Required for database-backed features
DATABASE_URL=postgresql://user:password@localhost:5432/pluspuls

# Optional one-time administrator bootstrap.
# Configure BOTH values before the first production start if an admin does not exist.
# Remove BOTH values together after confirming the administrator can sign in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Przelewy24. Leave sandbox true until real merchant credentials are configured.
P24_SANDBOX=true
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC_KEY=
P24_API_KEY=

# PayPal. Leave sandbox true until real app/webhook credentials are configured.
PAYPAL_SANDBOX=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
